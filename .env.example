# Copia este archivo a .env y completa los valores reales.
# Ver también prisma.config.ts para la carga de DATABASE_URL en comandos de Prisma.

# Postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/vitalid?schema=public"

# Puerto HTTP del servicio (default 3000 si se omite)
PORT=3000

# Requeridos: sin ellos la app no arranca (ver src/common/config/jwt-secret.ts)
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Correo transaccional vía Resend (https://resend.com/api-keys). Sin esta key
# el envío de correo (activación, OTP, reset password) falla explícitamente.
RESEND_API_KEY=""
# Opcional. Debe ser un remitente/dominio verificado en Resend.
# Si se omite, el código usa "VitalID <no-reply@vitalguard.app>".
# MAIL_FROM="VitalID <no-reply@vitalguard.app>"

# Clave compartida para llamadas servicio-a-servicio (VitalGuard API -> GET /auth/user/:id).
# Debe coincidir con INTERNAL_SERVICE_KEY en el .env de VitalGuard API.
INTERNAL_SERVICE_KEY=""

# OAuth 2.0 — Account Linking (Vital ID como Authorization Server para Alexa)
OAUTH_ACCESS_TOKEN_EXPIRES="24h"
OAUTH_REFRESH_TOKEN_EXPIRES="30d"
OAUTH_AUTHORIZATION_CODE_EXPIRES="10m"
# URL base pública de este servicio. En producción es obligatoria: si falta,
# el account linking de Alexa fallará explícitamente en vez de redirigir a
# localhost (ver src/modules/oauth/oauth.service.ts). En local no hace falta,
# cae a http://localhost:3000.
VITAL_ID_BASE_URL="http://localhost:3000"
# Opcionales: si no se definen, se derivan de VITAL_ID_BASE_URL.
# OAUTH_LOGIN_URL="http://localhost:5173/#login"
# OAUTH_CONSENT_URL="http://localhost:5173/#authorize"

# development | production — habilita validaciones estrictas de config en prod
NODE_ENV="development"
